{
  "version": 2,
  "buildCommand": "npx prisma generate && npx nest build && node scripts/bake-db.js",
  "installCommand": "npm install",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "prisma/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
